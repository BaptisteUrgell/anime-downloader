{
  "openapi": "3.1.0",
  "info": {
    "title": "Anime Downloader API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/jobs/preview": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Preview Season Endpoint",
        "operationId": "previewSeason",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeasonPreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs Endpoint",
        "operationId": "listJobs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobResponse"
                  },
                  "type": "array",
                  "title": "Response Listjobs"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job Endpoint",
        "operationId": "createJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/retry-failed": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Retry Failed Endpoint",
        "operationId": "retryFailedEpisodes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryFailedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/dismiss-completed": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Dismiss Completed Endpoint",
        "operationId": "dismissCompletedJobs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DismissCompletedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}/dismiss": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Dismiss Job Endpoint",
        "operationId": "dismissJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Endpoint",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "List Library Endpoint",
        "operationId": "listLibrary",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LibrarySeriesResponse"
                  },
                  "type": "array",
                  "title": "Response Listlibrary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateJobRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateJobRequest"
      },
      "DismissCompletedResponse": {
        "properties": {
          "dismissed_count": {
            "type": "integer",
            "title": "Dismissed Count"
          }
        },
        "type": "object",
        "required": [
          "dismissed_count"
        ],
        "title": "DismissCompletedResponse"
      },
      "EpisodePreviewResponse": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "number"
        ],
        "title": "EpisodePreviewResponse"
      },
      "EpisodeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "season_id": {
            "type": "string",
            "title": "Season Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/EpisodeStatus"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "season_id",
          "number",
          "status",
          "source_url"
        ],
        "title": "EpisodeResponse"
      },
      "EpisodeStatus": {
        "type": "string",
        "enum": [
          "pending",
          "downloading",
          "completed",
          "failed",
          "skipped"
        ],
        "title": "EpisodeStatus"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "adapter_id": {
            "type": "string",
            "title": "Adapter Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "series_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Series Id"
          },
          "season_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season Id"
          },
          "total_episodes": {
            "type": "integer",
            "title": "Total Episodes"
          },
          "completed_episodes": {
            "type": "integer",
            "title": "Completed Episodes"
          },
          "failed_episodes": {
            "type": "integer",
            "title": "Failed Episodes"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "current_episode_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Episode Number"
          },
          "episode_progress_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Progress Percent"
          },
          "dismissed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismissed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_url",
          "adapter_id",
          "status",
          "total_episodes",
          "completed_episodes",
          "failed_episodes"
        ],
        "title": "JobResponse"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed"
        ],
        "title": "JobStatus"
      },
      "LibrarySeasonResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodeResponse"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "series_id",
          "number",
          "episodes"
        ],
        "title": "LibrarySeasonResponse"
      },
      "LibrarySeriesResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "seasons": {
            "items": {
              "$ref": "#/components/schemas/LibrarySeasonResponse"
            },
            "type": "array",
            "title": "Seasons"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "seasons"
        ],
        "title": "LibrarySeriesResponse"
      },
      "PreviewJobRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "PreviewJobRequest"
      },
      "RetryFailedRequest": {
        "properties": {
          "season_id": {
            "type": "string",
            "title": "Season Id"
          }
        },
        "type": "object",
        "required": [
          "season_id"
        ],
        "title": "RetryFailedRequest"
      },
      "SeasonPreviewResponse": {
        "properties": {
          "series_title": {
            "type": "string",
            "title": "Series Title"
          },
          "season_number": {
            "type": "integer",
            "title": "Season Number"
          },
          "episode_count": {
            "type": "integer",
            "title": "Episode Count"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodePreviewResponse"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "series_title",
          "season_number",
          "episode_count",
          "episodes"
        ],
        "title": "SeasonPreviewResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
